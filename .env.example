# Copy this file to .env and fill in your values.
# Never commit the actual .env file — it is listed in .gitignore.

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_REGION=eu-central-1
AWS_PROFILE=default          # Optional: named AWS CLI profile
# AWS_ACCESS_KEY_ID=          # Set via AWS CLI profile or IAM role — do not hardcode here
# AWS_SECRET_ACCESS_KEY=      # Same as above

# ── S3 Data Lake ─────────────────────────────────────────────────────────────
S3_BUCKET_NAME=delivery-data-platform-dev

# ── Kaggle ───────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_UID=50000

# ── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev              # dev | prod

# ── Weather API (Phase 5 — provider TBD) ────────────────────────────────────
# WEATHER_API_KEY=
# WEATHER_API_BASE_URL=
